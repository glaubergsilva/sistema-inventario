# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=

# URL pública do portal (usada no comando de instalação do agente)
PORTAL_URL=https://inventario.seudominio.com.br

# Cloudflare D1 (API HTTP). Sem estas variáveis o portal usa um SQLite local (dados-local.sqlite).
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# Token de API com permissão "D1: Edit"
CF_API_TOKEN=
